# Supabase credentials for the flashcards app.
#
# LOCAL: copy this file to  .streamlit/secrets.toml  and fill in the real values.
# STREAMLIT CLOUD: paste the same two lines into  App > Settings > Secrets.
#
# Use the **service_role** key (Project Settings > API). It stays server-side only
# and is never sent to the browser, so it can bypass row-level security.

SUPABASE_URL = "https://YOUR-PROJECT-ref.supabase.co"
SUPABASE_KEY = "YOUR-SERVICE-ROLE-KEY"
